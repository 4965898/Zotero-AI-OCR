{
  "name": "zotero-ai-ocr",
  "type": "module",
  "version": "1.9.4",
  "description": "AI OCR plugin for Zotero - AI-powered OCR recognition with PaddleOCR and MinerU",
  "config": {
    "addonName": "AI OCR",
    "addonID": "aiocr@zotero-plugin.com",
    "addonRef": "aiocr",
    "addonInstance": "AIOCR",
    "prefsPrefix": "extensions.zotero.aiocr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4965898/Zotero-AI-OCR.git"
  },
  "author": "AIOCR4Zotero",
  "bugs": {
    "url": "https://github.com/4965898/Zotero-AI-OCR/issues"
  },
  "homepage": "https://github.com/4965898/Zotero-AI-OCR#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && node scripts/fix-prefs.js",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
